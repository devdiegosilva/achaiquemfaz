# Servidor
PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA (Anthropic Claude)
ANTHROPIC_API_KEY=

# Evolution API (WhatsApp)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# URL pública deste backend (usada nos links de retorno do checkout)
BACKEND_PUBLIC_URL=

# Asaas (pagamento/assinatura de fornecedores)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASSINATURA_VALOR_MENSAL=97.90

# Diretório (/diretorio) — módulo em paralelo ao fluxo do WhatsApp
# Enquanto "false", cadastro no diretório é gratuito (sem checkout Asaas)
DIRETORIO_EXIGE_ASSINATURA=false
# Chave do painel /diretorio/admin (deixe vazio para desativar o painel)
ADMIN_CHAVE=
